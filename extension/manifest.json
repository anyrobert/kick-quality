{
  "manifest_version": 3,
  "name": "Kick Quality Enforcer",
  "version": "1.0.0",
  "description": "Plays Kick.com streams at your preferred quality instead of Kick's 720p auto cap.",
  "browser_specific_settings": {
    "gecko": {
      "id": "kick-quality-enforcer@anyrobert",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://kick.com/*"],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_title": "Kick Quality",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["https://kick.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://kick.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
